generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}
enum ConsultationStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(320)
  passwordHash String @map("password_hash")
  role Role
  status UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  patient PatientProfile?
  doctor DoctorProfile?
  refreshTokens RefreshToken[]
  mfaCredential MfaCredential?
  passwordResetTokens PasswordResetToken[]
  auditLogs AuditLog[]
  @@index([role, status])
  @@map("users")
}
model PatientProfile {
  userId String @id @map("user_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(200)
  phone String? @db.VarChar(32)
  timeZone String @default("Asia/Kolkata") @map("time_zone")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[]
  @@map("patient_profiles")
}
model DoctorProfile {
  userId String @id @map("user_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(200)
  bio String? @db.Text
  feeMinor Int @map("fee_minor")
  currency String @default("INR") @db.Char(3)
  verified Boolean @default(false)
  timeZone String @default("Asia/Kolkata") @map("time_zone")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties DoctorSpecialty[]
  slots AvailabilitySlot[]
  consultations Consultation[]
  @@index([verified, feeMinor])
  @@map("doctor_profiles")
}
model Specialty {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  doctors DoctorSpecialty[]
  @@map("specialties")
}
model DoctorSpecialty {
  doctorId String @map("doctor_id") @db.Uuid
  specialtyId String @map("specialty_id") @db.Uuid
  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  @@id([doctorId, specialtyId])
  @@index([specialtyId, doctorId])
  @@map("doctor_specialties")
}
model AvailabilitySlot {
  id String @id @default(uuid()) @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  startsAt DateTime @map("starts_at")
  endsAt DateTime @map("ends_at")
  timeZone String @map("time_zone")
  cancelledAt DateTime? @map("cancelled_at")
  doctor DoctorProfile @relation(fields: [doctorId], references: [userId])
  consultation Consultation?
  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt, endsAt])
  @@map("availability_slots")
}
model Consultation {
  id String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  slotId String @unique @map("slot_id") @db.Uuid
  status ConsultationStatus @default(SCHEDULED)
  feeMinor Int @map("fee_minor")
  currency String @default("INR") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  patient PatientProfile @relation(fields: [patientId], references: [userId])
  doctor DoctorProfile @relation(fields: [doctorId], references: [userId])
  slot AvailabilitySlot @relation(fields: [slotId], references: [id])
  prescription Prescription?
  payment Payment?
  @@index([patientId, createdAt(sort: Desc)])
  @@index([doctorId, status, createdAt])
  @@map("consultations")
}
model Prescription {
  id String @id @default(uuid()) @db.Uuid
  consultationId String @unique @map("consultation_id") @db.Uuid
  version Int @default(1)
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  consultation Consultation @relation(fields: [consultationId], references: [id])
  items PrescriptionItem[]
  @@map("prescriptions")
}
model PrescriptionItem {
  id String @id @default(uuid()) @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid
  medicine String @db.VarChar(200)
  dosage String @db.VarChar(200)
  instructions String? @db.VarChar(500)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@index([prescriptionId])
  @@map("prescription_items")
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  consultationId String @unique @map("consultation_id") @db.Uuid
  amountMinor Int @map("amount_minor")
  currency String @default("INR") @db.Char(3)
  status PaymentStatus @default(PENDING)
  providerReference String? @unique @map("provider_reference")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  consultation Consultation @relation(fields: [consultationId], references: [id])
  @@map("payments")
}
model IdempotencyKey {
  key String @id @db.VarChar(200)
  actorId String @map("actor_id") @db.Uuid
  method String @db.VarChar(10)
  path String @db.VarChar(300)
  fingerprint String @db.Char(64)
  responseStatus Int? @map("response_status")
  responseBody Json? @map("response_body")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("idempotency_keys")
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  familyId String @map("family_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  replacedById String? @map("replaced_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([familyId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
model MfaCredential {
  userId String @id @map("user_id") @db.Uuid
  secretEncrypted String @map("secret_encrypted")
  enabledAt DateTime? @map("enabled_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("mfa_credentials")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(120)
  resourceType String @map("resource_type") @db.VarChar(100)
  resourceId String? @map("resource_id") @db.VarChar(200)
  metadata Json?
  correlationId String @map("correlation_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  eventType String @map("event_type") @db.VarChar(120)
  aggregateId String @map("aggregate_id") @db.VarChar(200)
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts Int @default(0)
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(80)
  externalId String @map("external_id") @db.VarChar(200)
  receivedAt DateTime @default(now()) @map("received_at")
  @@unique([provider, externalId])
  @@map("webhook_events")
}
